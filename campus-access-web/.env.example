# 智慧校园微服务本机配置模板
# 使用方式：cp .env.example .env，然后替换所有 CHANGE_ME_* 占位值。
# .env 包含本机密码和密钥，禁止提交到 Git。

# 身份域 Schema：账号、人员、会话、生物凭证、车辆、通知和审计
IDENTITY_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_access_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
IDENTITY_DB_USERNAME=unified_identity_app
IDENTITY_DB_PASSWORD=CHANGE_ME_IDENTITY_DB_PASSWORD

# 预约域 Schema：来访预约、审批和凭证签发协调
APPOINTMENT_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_access_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
APPOINTMENT_DB_USERNAME=unified_appointment_app
APPOINTMENT_DB_PASSWORD=CHANGE_ME_APPOINTMENT_DB_PASSWORD

# 通行域 Schema：通行凭证、设备、校门、规则和通行记录
PASSAGE_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_access_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
PASSAGE_DB_USERNAME=unified_passage_app
PASSAGE_DB_PASSWORD=CHANGE_ME_PASSAGE_DB_PASSWORD

# 安全事件域 Schema：安全事件和黑名单
INCIDENT_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_access_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
INCIDENT_DB_USERNAME=unified_incident_app
INCIDENT_DB_PASSWORD=CHANGE_ME_INCIDENT_DB_PASSWORD

# 所有 Java 微服务内部接口共用的随机密钥，至少 32 个字符。
CAMPUS_INTERNAL_KEY=CHANGE_ME_WITH_OPENSSL_RANDOM_HEX

# 预约审批与通行凭证签发恢复数据的独立加密密钥，至少 32 个字符。
CREDENTIAL_RECOVERY_KEY=CHANGE_ME_WITH_ANOTHER_OPENSSL_RANDOM_HEX

# 正式 Java 微服务路由开关
APPOINTMENT_SERVICE_ENABLED=true
ACCESS_SERVICE_ENABLED=true
EXCEPTION_SERVICE_ENABLED=true
AGGREGATION_SERVICE_ENABLED=true

# 服务内部业务接口开关
APPOINTMENT_INTERNAL_API_ENABLED=true
ACCESS_INTERNAL_API_ENABLED=true
EXCEPTION_INTERNAL_API_ENABLED=true
ACCESS_FINAL_APPROVAL_ENABLED=true
EXCEPTION_DISPOSITION_ENABLED=true

# 服务发现名称
EXCEPTION_SERVICE_NAME=exception-service

# 故障注入只用于受控测试，日常运行必须关闭。
ACCESS_FAULT_INJECTION_ENABLED=false
EXCEPTION_FAULT_INJECTION_ENABLED=false

# 本机演示功能；共享环境建议关闭。
USER_DEMO_ENABLED=false
USER_DEMO_PHONES=

# 可选短信服务；留空时不连接外部短信平台。
USER_SMS_URL=
USER_SMS_KEY=

# Vite 开发代理目标
VITE_API_PROXY_TARGET=http://127.0.0.1:19800
